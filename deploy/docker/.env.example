# williamtells-bb host stack (docker-compose.yml). Keep the real .env 0600: it holds the worker token
# and the database password.

POSTGRES_PASSWORD=REPLACE_ME                 # e.g. `openssl rand -hex 24`
WILLIAMTELLS_DATA_DIR=REPLACE_ME             # host dir, owned by uid 10001 (jobs + blobs; shared by api and dispatcher)
WILLIAMTELLS_KEY_DIR=REPLACE_ME              # host dir, uid 10001, 0700, NOT inside the data dir: attest.key, dispatcher-only
WILLIAMTELLS_PKI_DIR=REPLACE_ME              # ca.crt, dispatcher.crt, dispatcher.key readable by uid 10001
WILLIAMTELLS_PORT=8005                       # Loadout: LOADOUT_WILLIAMTELLS_URL=http://<host>:8005
# WILLIAMTELLS_BIND_ADDR=0.0.0.0

# ---- the Mac pool ----
BLASTBOX_STATIC_WORKERS=https://REPLACE_ME:8765        # comma-list, one per Mac agent
BLASTBOX_STATIC_WORKER_TOKEN=REPLACE_ME                # == each agent's BLASTBOX_WORKER_AGENT_TOKEN
BLASTBOX_POOL_CEILING=1                                # <= number of Mac agents
BLASTBOX_POOL_WARM_SIZE=1
BLASTBOX_DISPATCH_CONCURRENCY=1                        # == number of Mac agents
BLASTBOX_ENGINES=williamtells=mac-http-agent           # informational on a static pool

# ---- engine policy ----
BLASTBOX_ALLOWED_ENGINES=williamtells
BLASTBOX_ENGINE_WILLIAMTELLS_PARAM_KEYS=WTQRK_MODE,WTQRK_CONFIG
BLASTBOX_ENGINE_WILLIAMTELLS_RESERVED_KEYS=WTQRK_SCAN_BIN,WTQRK_SELF_TEST
BLASTBOX_ENGINE_WILLIAMTELLS_DEFAULT_PARAMS=WTQRK_MODE=default
BLASTBOX_ENGINE_WILLIAMTELLS_NETPOLICY=none
BLASTBOX_ENGINE_WILLIAMTELLS_ALLOWED_RUNTIMES=static
# WTQRK_SERVE_UI=0                                     # API-only
# BLASTBOX_API_KEY=…                                   # or front the ingress with an auth proxy
