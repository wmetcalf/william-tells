# williamtells-bb host stack (docker-compose.yml). Keep the real .env 0600: it holds the worker token
# and the database password. Comments go on their own lines; values never contain whitespace.

# e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=REPLACE_ME
# Host dir, owned by uid 10001: jobs + blobs, shared by api and dispatcher.
WILLIAMTELLS_DATA_DIR=REPLACE_ME
# Host dir, uid 10001, 0700, NOT inside the data dir: attest.key, mounted only into the dispatcher.
WILLIAMTELLS_KEY_DIR=REPLACE_ME
# ca.crt, dispatcher.crt, dispatcher.key, readable by uid 10001.
WILLIAMTELLS_PKI_DIR=REPLACE_ME
# Loadout: LOADOUT_WILLIAMTELLS_URL=http://<host>:8005
WILLIAMTELLS_PORT=8005
# WILLIAMTELLS_BIND_ADDR=0.0.0.0
# Required: the ingress bearer key, e.g. `openssl rand -hex 32`. Clients send
# `Authorization: Bearer <key>` (Loadout: LOADOUT_WILLIAMTELLS_API_KEY).
BLASTBOX_API_KEY=REPLACE_ME

# ---- the Mac pool ----
# Comma-separated, one https://<mac-ip>:8765 per Mac agent.
BLASTBOX_STATIC_WORKERS=https://REPLACE_ME:8765
# Must equal each agent's BLASTBOX_WORKER_AGENT_TOKEN.
BLASTBOX_STATIC_WORKER_TOKEN=REPLACE_ME
# Pool ceiling <= number of Mac agents; dispatch concurrency == number of Mac agents.
BLASTBOX_POOL_CEILING=1
BLASTBOX_POOL_WARM_SIZE=1
BLASTBOX_DISPATCH_CONCURRENCY=1
# Informational on a static pool.
BLASTBOX_ENGINES=williamtells=mac-http-agent

# ---- engine policy ----
BLASTBOX_ALLOWED_ENGINES=williamtells
BLASTBOX_ENGINE_WILLIAMTELLS_PARAM_KEYS=WTQRK_MODE,WTQRK_CONFIG
BLASTBOX_ENGINE_WILLIAMTELLS_RESERVED_KEYS=WTQRK_SCAN_BIN,WTQRK_SELF_TEST
BLASTBOX_ENGINE_WILLIAMTELLS_DEFAULT_PARAMS=WTQRK_MODE=default
BLASTBOX_ENGINE_WILLIAMTELLS_NETPOLICY=none
BLASTBOX_ENGINE_WILLIAMTELLS_ALLOWED_RUNTIMES=static
# The browser UI can't send the bearer key: reach it through a proxy that authenticates you and
# adds the header, or turn it off:
# WTQRK_SERVE_UI=0
