# William Tells under blastbox -- the HOST side: ingress (`blastbox serve`) + dispatcher
# (`blastbox dispatch`). Both processes source this ONE file so they can't drift apart.
# Mac-only: blastbox deploy/macos/io.blastbox.{ingress,dispatcher}.plist read it via
# BLASTBOX_ENV_FILE. Mixed fleet: run these on Linux next to the other engines; only the
# worker side (williamtells-worker.env.example) lives on the Macs.
# Plain KEY=value lines (sourced with `set -a`). Keep it 0600: it holds the agent token.

# ---- shared job queue + job/blob root (serve and dispatch MUST agree) ----
BLASTBOX_DATABASE_URL=sqlite:////Users/blastbox/var/williamtells/jobs.db   # postgresql://… on Linux
BLASTBOX_JOB_ROOT=/Users/blastbox/var/williamtells/jobs

# ---- ingress ----
BLASTBOX_SERVE_HOST=127.0.0.1
BLASTBOX_SERVE_PORT=8005                      # Loadout: LOADOUT_WILLIAMTELLS_URL=http://<host>:8005
BLASTBOX_ALLOWED_ENGINES=williamtells
BLASTBOX_INGRESS_EXTENSION=william_tells.blastbox_ingress:make_extension
# WTQRK_SERVE_UI=0                            # API-only (Loadout never uses the UI)
# BLASTBOX_API_KEY=…                          # or put the ingress behind an auth proxy

# ---- dispatcher: a static pool of Mac worker agents ----
BLASTBOX_POOL_RUNTIME=static
BLASTBOX_STATIC_WORKERS=127.0.0.1:8765        # or mac1:8765,mac2:8765
BLASTBOX_STATIC_WORKER_TOKEN=change-me        # == each agent's BLASTBOX_WORKER_AGENT_TOKEN
BLASTBOX_DISPATCH_CONCURRENCY=1               # one per agent: an agent runs one job at a time
BLASTBOX_ENGINES=williamtells=wtqrk-mac-worker  # informational on a static pool
# Signed execution receipts (GET /v1/jobs/{id}/attestation); pin `blastbox attest-key` output
# in Loadout's LOADOUT_ATTESTATION_KEYS.
BLASTBOX_ATTEST_KEY=/Users/blastbox/var/williamtells/attest.key

# Client-forwardable params (default-DENY): mode + mutation config only. Clients send each as a
# repeated `params=KEY=VALUE` form field on POST /v1/jobs.
BLASTBOX_ENGINE_WILLIAMTELLS_PARAM_KEYS=WTQRK_MODE,WTQRK_CONFIG
# Never client-settable: the binary path and the self-test gate.
BLASTBOX_ENGINE_WILLIAMTELLS_RESERVED_KEYS=WTQRK_SCAN_BIN,WTQRK_SELF_TEST
BLASTBOX_ENGINE_WILLIAMTELLS_DEFAULT_PARAMS=WTQRK_MODE=default
# Decoding is pure-local. (macOS workers deny network regardless.)
BLASTBOX_ENGINE_WILLIAMTELLS_NETPOLICY=none
# Pin the engine to the static Mac tier so a pool change can't route it elsewhere.
BLASTBOX_ENGINE_WILLIAMTELLS_ALLOWED_RUNTIMES=static
