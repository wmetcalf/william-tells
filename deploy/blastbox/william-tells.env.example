# William Tells under blastbox — engine slice. Two halves: the Mac worker, and the dispatcher.
# Design: blastbox docs/superpowers/specs/2026-10-10-macos-sandbox-design.md

# ============================== Mac worker (runs the http_agent) ==============================
export BLASTBOX_ENGINE=william_tells.blastbox_engine:WilliamTellsEngine
export WTQRK_SCAN_BIN=/opt/william-tells/bin/wtqrk-scan     # `swift build -c release` output
export BLASTBOX_SANDBOX=seatbelt        # default; or `appsandbox` after `blastbox macos prepare`
export BLASTBOX_WORKER_AGENT_TOKEN=change-me
export BLASTBOX_WORKER_AGENT_BIND=127.0.0.1                 # Mac-only; LAN address for a remote dispatcher
# python -I -m blastbox.worker.http_agent                   # (see blastbox deploy/macos/ for launchd)

# ============================== Dispatcher ====================================================
export BLASTBOX_POOL_RUNTIME=static
export BLASTBOX_STATIC_WORKERS=127.0.0.1:8765               # or mac1:8765,mac2:8765
export BLASTBOX_STATIC_WORKER_TOKEN=change-me
export BLASTBOX_ENGINES=william-tells=wtqrk-mac-worker      # informational on a static pool

# Client-forwardable params (default-DENY): mode + mutation config only.
export BLASTBOX_ENGINE_WILLIAM_TELLS_PARAM_KEYS=WTQRK_MODE,WTQRK_CONFIG
# Never client-settable: the binary path and the self-test gate.
export BLASTBOX_ENGINE_WILLIAM_TELLS_RESERVED_KEYS=WTQRK_SCAN_BIN,WTQRK_SELF_TEST
export BLASTBOX_ENGINE_WILLIAM_TELLS_DEFAULT_PARAMS=WTQRK_MODE=default
# Decoding is pure-local. (macOS workers deny network regardless.)
export BLASTBOX_ENGINE_WILLIAM_TELLS_NETPOLICY=none
# Pin the engine to the static Mac tier so a pool change can't route it elsewhere.
export BLASTBOX_ENGINE_WILLIAM_TELLS_ALLOWED_RUNTIMES=static
