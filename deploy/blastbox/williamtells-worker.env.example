# William Tells under blastbox -- the WORKER side, on each Mac: the generic http_agent serving
# the engine. Put these in blastbox deploy/macos/io.blastbox.worker-agent.plist's
# EnvironmentVariables. Gate a Mac into the pool with:
#   blastbox macos doctor --backend seatbelt --accelerator gpu --accelerator ane \
#       -- /opt/william-tells/bin/wtqrk-scan self-test

BLASTBOX_ENGINE=william_tells.blastbox_engine:WilliamTellsEngine
WTQRK_SCAN_BIN=/opt/william-tells/bin/wtqrk-scan   # `swift build -c release` output
BLASTBOX_SANDBOX=seatbelt                          # default; or `appsandbox` after `blastbox macos prepare`
BLASTBOX_WORKER_AGENT_TOKEN=change-me              # == the dispatcher's BLASTBOX_STATIC_WORKER_TOKEN
BLASTBOX_WORKER_AGENT_BIND=127.0.0.1               # Mac-only; the LAN address for a remote dispatcher
# BLASTBOX_WORKER_AGENT_ALLOW_CIDRS=10.0.0.5/32    # with a LAN bind: only the dispatcher may connect
