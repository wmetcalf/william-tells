# William Tells under blastbox -- the WORKER side, on each Mac. Two agents speak the same
# blastbox worker protocol; the dispatcher can't tell them apart.

# ---- native (recommended): wtqrk-worker, no Python on the Mac ----
# Each image runs in a fresh wtqrk-scan process that the kernel App-Sandboxes at exec, reading
# the image from an inherited file descriptor. Gate: a known-QR self-test plus a confinement probe
# (no read outside its container, no network) at every start; failing it makes every job
# engine_error. Install: deploy/macos/io.github.wmetcalf.wtqrk-worker.plist.
WTQRK_SCAN_BIN=/opt/william-tells/bin/wtqrk-scan   # default: next to wtqrk-worker
WTQRK_WORKER_SLOT=0                                # one per agent on a Mac (own container each)
BLASTBOX_WORKER_AGENT_TOKEN=change-me              # == the dispatcher's BLASTBOX_STATIC_WORKER_TOKEN
BLASTBOX_WORKER_AGENT_BIND=127.0.0.1               # Mac-only; the LAN address for a remote dispatcher
BLASTBOX_WORKER_AGENT_PORT=8765
# BLASTBOX_WORKER_AGENT_ALLOW_CIDRS=10.0.0.5/32    # with a LAN bind: only the dispatcher may connect
# wtqrk-worker does not terminate TLS: bind loopback or a private network, or front it with a proxy.

# ---- alternative: blastbox's Python http_agent + the Python engine ----
# Same results, through blastbox's seatbelt (sandbox-exec) or appsandbox backend. Use it for
# TLS/mTLS on the agent itself. Put these in blastbox deploy/macos/io.blastbox.worker-agent.plist;
# gate a Mac with:
#   blastbox macos doctor --backend seatbelt --accelerator gpu --accelerator ane \
#       -- /opt/william-tells/bin/wtqrk-scan self-test
# BLASTBOX_ENGINE=william_tells.blastbox_engine:WilliamTellsEngine
# BLASTBOX_SANDBOX=seatbelt                        # or `appsandbox` after `blastbox macos prepare`
